# FocusLoop Environment Configuration
# Copy this file to .env and fill in your values

# Anthropic API Key (required for AI features, app works without it in demo mode)
ANTHROPIC_API_KEY=

# Anthropic Model (optional, defaults to claude-sonnet-4-20250514)
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Gemini API key for AI study summaries and topic plans
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Server port (optional, defaults to 3001)
PORT=3001
