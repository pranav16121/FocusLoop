# FocusLoop Environment Configuration
# Copy this file to .env and fill in your values. Never commit .env.

# AI planner provider: gemini | demo (demo = offline planner only, no Gemini calls)
AI_PROVIDER=gemini

# Google Gemini API key (server only - never exposed to the browser)
GEMINI_API_KEY=your-gemini-api-key-here

# Gemini Flash-class model. Check current names at https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.8-flash

# Optional: Anthropic key for the legacy breakdown/reflection endpoints
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Server port (Azure App Service sets this automatically)
PORT=3001
