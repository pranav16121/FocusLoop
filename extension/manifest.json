{
  "manifest_version": 3,
  "name": "FocusLoop Visual Focus Assist",
  "version": "0.1.0",
  "description": "Local-only tab awareness and optional on-device camera signals for FocusLoop.",
  "permissions": ["tabs", "windows", "offscreen", "storage", "nativeMessaging"],
  "host_permissions": ["http://localhost:5173/*", "http://127.0.0.1:5173/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [{ "matches": ["http://localhost:5173/*", "http://127.0.0.1:5173/*"], "js": ["bridge.js"], "run_at": "document_start" }],
  "action": { "default_title": "FocusLoop Visual Focus Assist" },
  "web_accessible_resources": [{ "resources": ["models/*", "vendor/*"], "matches": ["<all_urls>"] }]
}
